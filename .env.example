# ============================================================
#  .env.example  –  Salin file ini menjadi .env lalu isi nilainya
#  JANGAN commit file .env ke Git!
# ============================================================

# ── Google Earth Engine ──────────────────────────────────────
# Isi dengan GEE project ID milik Anda
# Dapatkan di: https://console.cloud.google.com/
GEE_PROJECT=YOUR_GEE_PROJECT_ID

# ── Lokasi default (opsional) ────────────────────────────────
# Koordinat pusat peta saat belum ada AOI
DEFAULT_LAT=-6.9175
DEFAULT_LON=107.6191
DEFAULT_ZOOM=11
